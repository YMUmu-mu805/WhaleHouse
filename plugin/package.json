{
  "name": "WhaleHouse",
  "version": "1.0.9",
  "description": "小屋：把 bot 的房子挂进 DSH 设置（小屋格局 / 高级设置两页），另带会话栏的「小屋」看板。",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "slots"
      ],
      "external": [
        "react"
      ]
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "house",
    "whalehouse"
  ]
}
